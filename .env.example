# Copy to .env (gitignored) and fill in. just exports every variable here to the commands it runs.
# Values go right after "=", no quotes; avoid "$" in values (just's .env loader would expand it).
# Every key of config/config.yaml can be overridden as GO_<SECTION>_<KEY>, upper case.

# Seals the session cookie. The value in config.yaml is public: set a long random one on every live
# environment, ie: openssl rand -base64 32
GO_APP_ENCRYPTIONKEY=

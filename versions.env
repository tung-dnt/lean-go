# Single source of truth for the pinned asset-toolchain versions, shared by the
# justfile (sourced in `tailwind-install`) and the Dockerfile (which runs that same
# recipe). Bump a version here and both local dev and the prod image pick it up.
# Keep every line as KEY=value with NO spaces around `=`, so `/bin/sh` can source it.
TAILWIND_VERSION=4.3.3
DAISYUI_VERSION=5.7.37

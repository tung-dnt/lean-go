# Single source of truth for the pinned asset-toolchain versions, shared by the
# Makefile (`include versions.env`) and the Dockerfile (`COPY versions.env` +
# sourced inside RUN). Bump a version here and both local dev and the prod image
# pick it up. Keep every line as KEY=value with NO spaces around `=`, so both
# `make` and `/bin/sh` can parse the same file.
TAILWIND_VERSION=4.3.3
DAISYUI_VERSION=5.7.37
